<h1><%= title %></h1>

<% if (favorites.length === 0) { %>
  <p>You have no favorite vehicles yet.</p>
<% } else { %>
  <ul>
    <% favorites.forEach(vehicle => { %>
      <li class="favorite-list">
        <strong><%= vehicle.inv_make %> <%= vehicle.inv_model %></strong>

        <form action="/favorites/remove" method="POST" style="display:inline;" class="remove-fav-form">
          <input type="hidden" name="inv_id" value="<%= vehicle.inv_id %>" required>
          <button type="submit">Remove</button>
        </form>
      </li>
    <% }) %>
  </ul>
<% } %>
