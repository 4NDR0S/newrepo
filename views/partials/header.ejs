<header class="modern-header">
  <div class="header-inner">

    <div class="brand">
      <a href="/" title="Return to home page">CSE Motors</a>
    </div>

    <div class="account-area">
      <% if (loggedin && accountData) { %>

        <a href="/account/" class="welcome-link">
          Welcome <%= accountData.account_firstname %>
        </a>

        <a href="/account/logout" class="logout-link">
          Logout
        </a>

      <% } else { %>

        <a href="/account/login" class="account-btn">
          My Account
        </a>

      <% } %>
    </div>

  </div>
</header>