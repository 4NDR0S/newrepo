<%- messages() %>

<!-- HERO -->
<section class="hero-cinematic">

  <div class="hero-gradient"></div>

  <div class="hero-content-modern">
    <span class="hero-tag">CSE Motors</span>

    <h1 class="hero-title">
      Drive the Future.
    </h1>

    <p class="hero-description">
      Premium vehicle management system built with Express & EJS.
      Secure role-based inventory control for admins and employees.
    </p>

    <div class="hero-buttons">
      <a href="/inv" class="btn-main">Explore Inventory</a>
      <a href="/account/login" class="btn-ghost">Admin Access</a>
    </div>
  </div>

</section>

<!-- FEATURES SECTION -->
<section class="modern-section">
  <div class="section-header">
    <h2>System Capabilities</h2>
    <p>Built for scalability, security, and real dealership workflows.</p>
  </div>

  <div class="modern-grid">
    
    <div class="modern-card">
      <span class="material-symbols-rounded modern-icon">
        lock
      </span>
      <h3>Role-Based Access</h3>
      <p>Admin and employee permissions to manage inventory securely.</p>
    </div>

    <div class="modern-card">
      <span class="material-symbols-rounded modern-icon">
        directions_car
      </span>
      <h3>Inventory Management</h3>
      <p>Add, edit, and control vehicle listings dynamically.</p>
    </div>

    <div class="modern-card">
      <span class="material-symbols-rounded modern-icon">
        bolt
      </span>
      <h3>Fast & Lightweight</h3>
      <p>Optimized Express architecture with server-side rendering.</p>
    </div>

    <div class="modern-card">
      <span class="material-symbols-rounded modern-icon">
        analytics
      </span>
      <h3>Structured Data</h3>
      <p>Organized vehicle categories and dynamic content rendering.</p>
    </div>

  </div>
</section>